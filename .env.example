# Copy to .env. Everything here is optional for `docker compose up`.

# The port Ludy's server listens on, on this machine only. The app looks
# for it at LUDY_SERVER, http://127.0.0.1:8080 unless set.
# LUDY_PORT=8080

# The Rivet engine's admin token. Change it if the engine's port is ever
# reachable from anywhere but the `ludy` service.
# RIVET_TOKEN=

# How long a shard no version uses is kept, in milliseconds.
# GC_GRACE_MS=86400000

# How long the engine waits for a server that went silent before it gives
# its drives to the next one, in milliseconds. See docker-compose.yml.
# RIVET_NODE_LOST_MS=2000

# With docker-compose.r2.yml: where the blobs go in Cloudflare R2.
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# With docker-compose.minio.yml.
# MINIO_USER=ludy
# MINIO_PASSWORD=
